VITE_API_URL=/api
# Keep false for real-world/source-backed operation. true only for offline judging/demo fixtures.
VITE_DEMO_MODE=false

# Google Identity Services Web OAuth client ID (same client as backend/.env).
# Never put a Google Client Secret in this file.
VITE_GOOGLE_CLIENT_ID=YOUR_ACTUAL_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
# Google Cloud Console: Authorized JavaScript origin for local Vite development.
# http://localhost:3000
