PORT=5000
DEMO_MODE=false
STORAGE_DIR=./data/runtime
# VERIFIED_GEOJSON_FILE=./data/runtime/verified-projects.geojson
PAIMANA_URL=https://ipm.mospi.gov.in/Home/PublicDashboard
# Optional future live-traffic integration. Keep empty unless a licensed provider is configured.
TRAFFIC_PROVIDER=none
TRAFFIC_API_KEY=

# Google Identity Services / OAuth Web client ID. Use the same real client ID as frontend/.env.
GOOGLE_CLIENT_ID=YOUR_ACTUAL_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
# Comma-separated Google emails allowed to sign in as Administrator
GOOGLE_ADMIN_EMAILS=admin@example.com
